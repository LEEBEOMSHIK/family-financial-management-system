# Web process only. Do not provide DATABASE_URL or FINANCIAL_DATA_KEY to Next.js.
APP_ENV=production
NODE_ENV=production
ENABLE_DEV_LOGIN=0
WEB_ORIGIN=https://family.example.com
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
# DEV_ACCOUNTS_FILE must not be configured. NEXT_PUBLIC_* must contain no secrets.
