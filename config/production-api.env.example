# API process only. Supply real values from the private runtime secret store.
APP_ENV=production
AUTH_PROVIDER=local_password
ENABLE_DEV_LOGIN=0
WEB_ORIGIN=https://family.example.com
# Use the restricted runtime DB role, never the owner or superuser.
DATABASE_URL=
# Restore the existing key for existing data; never generate a replacement.
FINANCIAL_DATA_KEY=
# DEV_ACCOUNTS_FILE and ROLE_STORE_PATH must not be configured.
