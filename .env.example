# Draft only. Application configuration validation is implemented in P1.
# Copy locally; never commit real secrets. Empty required values must fail closed.
APP_ENV=development
APP_TIMEZONE=Asia/Seoul
WEB_ORIGIN=http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:8000
DATABASE_URL=
TEST_DATABASE_URL=
SESSION_SECRET=
AUTH_PROVIDER=local_password
POLICY_ACTIVATED=false
BANK_PROVIDER=kakaobank
BANK_MODE=statement_import
BANK_API_ENABLED=false
NOTIFICATION_TRANSPORT=sink
EXTERNAL_NOTIFICATION_ENABLED=false
EVIDENCE_STORAGE=encrypted_postgresql
# API only. Local launcher reads var/secrets/financial-data.key; never regenerate on restart.
FINANCIAL_DATA_KEY=
AI_EXTERNAL_ENABLED=false
RAG_ENABLED=false
# Add provider-specific secrets only after a reviewed adapter is selected.
# Never use NEXT_PUBLIC_ for secrets or private database/provider URLs.
